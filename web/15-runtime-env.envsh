#!/bin/sh

# Sourced by the official nginx entrypoint before it renders templates. Railway assigns PORT to
# the public service; Compose keeps using NGINX_PORT and historically used PORT for the API.
export NGINX_PORT="${NGINX_PORT:-${PORT:-80}}"
export API_PORT="${API_PORT:-3000}"

# nginx requires an explicit resolver when proxy_pass contains a variable. Discover the runtime's
# resolver so the same image works with Docker DNS, Railway private DNS, and Kubernetes CoreDNS.
if [ -z "${RESOLVER:-}" ] || [ "$RESOLVER" = "auto" ]; then
  RESOLVER="$(awk '/^nameserver[[:space:]]+/ { print $2; exit }' /etc/resolv.conf)"
  case "$RESOLVER" in
    *:*) RESOLVER="[$RESOLVER]" ;;
  esac
  export RESOLVER
fi

if [ -z "${RESOLVER:-}" ]; then
  echo >&2 "No DNS resolver found in /etc/resolv.conf; set RESOLVER explicitly"
  exit 1
fi
